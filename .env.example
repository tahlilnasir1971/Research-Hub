# ==============================================================================
# RESEARCH HUB — ENVIRONMENT CONFIGURATION (ZERO-COST / PLACEHOLDERS ONLY)
# ==============================================================================
# IMPORTANT: All variables here are OPTIONAL. Research Hub runs 100% free
# out of the box without any keys for public paper search, discovery, and topics.
# Never commit real API keys or secrets to git.

# ------------------------------------------------------------------------------
# 1. OPTIONAL: OpenRouter AI Integration ($0 Free Model)
# ------------------------------------------------------------------------------
# Get a free key at https://openrouter.ai (no credit card required for free models).
# Research Hub will use free models ending in :free (e.g., meta-llama/llama-3.3-70b-instruct:free).
# If omitted, AI summary features are gracefully disabled while all search works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Public Scholarly APIs Polite Pool Contact Email
# ------------------------------------------------------------------------------
# OpenAlex and Crossref provide faster, higher-rate-limit polite pools if you
# provide a contact email header. No account or payment required.
POLITE_POOL_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# 3. OPTIONAL: Supabase Free Tier Auth & Database
# ------------------------------------------------------------------------------
# If omitted, bookmarks and reading lists will safely use local browser storage (100% free).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
