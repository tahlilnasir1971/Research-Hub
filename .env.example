# ==============================================================================
# RESEARCH HUB — ENVIRONMENT CONFIGURATION (PLACEHOLDERS ONLY)
# ==============================================================================
# Never put real API keys or secrets in this template. Local values belong in
# .env.local, which is ignored by Git.

# ------------------------------------------------------------------------------
# 1. OPTIONAL: OpenRouter AI integration
# ------------------------------------------------------------------------------
# Get a key at https://openrouter.ai. The default router selects from available
# free models. You can instead set a specific model ending in :free.
# If omitted, scholarly search and the library remain available without AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 2. OPTIONAL: Public Scholarly APIs Polite Pool Contact Email
# ------------------------------------------------------------------------------
# OpenAlex and Crossref provide faster, higher-rate-limit polite pools if you
# provide a contact email header.
POLITE_POOL_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# 3. OPTIONAL: Supabase Free Tier Auth & Database
# ------------------------------------------------------------------------------
# If omitted, bookmarks and reading lists use local browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
